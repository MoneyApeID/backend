ENV=production
PORT=8080
APP_PORT=8080

# Database
DB_HOST=db
DB_PORT=3306
DB_USER=moneyrich
DB_PASS=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=moneyrich
DB_TLS=false

# Redis
REDIS_ADDR=redis:6379
REDIS_PASS=change_me_redis_password
REDIS_DB=0

# S3
S3_ENDPOINT=s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
S3_BUCKET=moneyrich
S3_BUCKET_SERVER=moneyrich
S3_REGION=ap-southeast-1
S3_BASE_URL=

# Security
JWT_SECRET=change_me_jwt_secret_min_32_chars
CRON_KEY=change_me_cron_key
SF_API_KEY=change_me_internal_api_key
JWT_AUD=
JWT_ISS=

# CORS
CORS_ALLOWED_ORIGINS=https://moneyrich.co,https://www.moneyrich.co

# PakaiLink
PAKAILINK_BASE_URL=https://api.pakailink.id
PAKAILINK_CLIENT_KEY=your_pakailink_client_key
PAKAILINK_CLIENT_SECRET=your_pakailink_client_secret
PAKAILINK_PARTNER_ID=PTR00000TI
PAKAILINK_MERCHANT_ID=1031332780
PAKAILINK_STORE_ID=GATEPAY
PAKAILINK_TERMINAL_ID=1701103543259012
PAKAILINK_CHANNEL_ID=95222
PAKAILINK_PRIVATE_KEY_PATH=./keys/rsa_private_key.pem
PAKAILINK_PAYMENT_CALLBACK_URL=https://api.moneyrich.co/api/callback/payments
PAKAILINK_PAYOUT_CALLBACK_URL=https://api.moneyrich.co/api/callback/payouts
PAKAILINK_CALLBACK_PUBLIC_KEY_PATH=

# Optional: full DSN override
DB_DSN=
